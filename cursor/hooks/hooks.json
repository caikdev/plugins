{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/caik-hook.sh cursor-session-start"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "./hooks/caik-hook.sh user-prompt-submit --platform cursor"
      }
    ],
    "postToolUse": [
      {
        "command": "./hooks/caik-hook.sh post-tool-use --platform cursor"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "./hooks/caik-hook.sh post-tool-use-failure --platform cursor"
      }
    ],
    "stop": [
      {
        "command": "./hooks/caik-hook.sh cursor-session-end"
      }
    ],
    "sessionEnd": [
      {
        "command": "./hooks/caik-hook.sh cursor-session-end"
      }
    ]
  }
}
